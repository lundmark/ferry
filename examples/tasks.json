[
  {
    "label": "Ferry: pull current file",
    "command": "ferry",
    "args": ["pull", "$ZED_FILE"],
    "cwd": "$ZED_DIRNAME",
    "use_new_terminal": false,
    "reveal": "on_error"
  },
  {
    "label": "Ferry: push current file",
    "command": "ferry",
    "args": ["push", "$ZED_FILE"],
    "cwd": "$ZED_DIRNAME",
    "use_new_terminal": false,
    "reveal": "on_error"
  },
  {
    "label": "Ferry: compile-check current file",
    "command": "ferry",
    "args": ["cc", "$ZED_FILE"],
    "cwd": "$ZED_DIRNAME",
    "use_new_terminal": false,
    "reveal": "on_error"
  },
  {
    "label": "Ferry: project-wide status",
    "command": "ferry",
    "args": ["status"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "reveal": "always"
  },
  {
    "label": "Ferry: project-wide sync",
    "command": "ferry",
    "args": ["sync"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "reveal": "always"
  },
  {
    "label": "Ferry: DELETE current file locally and remotely",
    "command": "ferry",
    "args": ["rm", "$ZED_FILE"],
    "cwd": "$ZED_DIRNAME",
    "use_new_terminal": false,
    "reveal": "on_error"
  }
]
